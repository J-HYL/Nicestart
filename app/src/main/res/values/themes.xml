<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Base.Theme.NiceStart" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Mantiene el splash sin logo -->
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- Theme principal -->
    <style name="Theme.NiceStart" parent="Base.Theme.NiceStart" />

    <!-- Theme con ActionBar (si lo necesitas en alguna Activity) -->
    <style name="Theme.NiceStart.ActionBar" parent="Theme.Material3.DayNight">
        <item name="actionBarStyle">@style/TransparentActionBar</item>
    </style>

    <!-- ActionBar transparente y compatible con dark mode -->
    <style name="TransparentActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@android:color/transparent</item>
        <item name="displayOptions">showHome</item>

        <!-- Colores automáticos según el sistema -->
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="colorControlNormal">?attr/colorOnSurface</item>
    </style>

</resources>
